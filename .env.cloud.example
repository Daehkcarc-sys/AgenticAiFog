# Local cloud/Kafka development settings
CLOUD_SYNC_MODE=kafka
CLOUD_KAFKA_BOOTSTRAP=localhost:9092
CLOUD_KAFKA_TOPIC=sensor-data
CLOUD_KAFKA_DEAD_LETTER_TOPIC=fog-dead-letter
CLOUD_PUBLISH_RETRIES=2
CLOUD_PUBLISH_BACKOFF_SECONDS=0.25
CLOUD_DB_PATH=state/cloud_events.db
DIGITAL_TWIN_DB_PATH=state/digital_twin.db
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
