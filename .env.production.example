# Production Cloud Runtime Defaults
# Copy to .env.production and change secrets/hosts before deployment.

CLOUD_SYNC_MODE=kafka
CLOUD_KAFKA_BOOTSTRAP=redpanda:9092
CLOUD_KAFKA_TOPIC=sensor-data
CLOUD_KAFKA_DEAD_LETTER_TOPIC=fog-dead-letter
CLOUD_PUBLISH_RETRIES=5
CLOUD_PUBLISH_BACKOFF_SECONDS=1.0

CLOUD_DB_PATH=/app/state/cloud_events.db
DIGITAL_TWIN_DB_PATH=/app/state/digital_twin.db

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050
# REQUIRED: replace before exposing the dashboard.
DASHBOARD_TOKEN=change-this-dashboard-token
# Optional stronger RBAC. If unset, DASHBOARD_TOKEN is used for all roles.
DASHBOARD_READ_TOKEN=
DASHBOARD_WRITE_TOKEN=
DASHBOARD_ADMIN_TOKEN=
DASHBOARD_AUDIT_PATH=/app/logs/dashboard_audit.jsonl

# Retention/backups
CLOUD_EVENT_RETENTION_DAYS=90
BACKUP_DIR=/app/backups

DB_BACKEND=postgres
DATABASE_URL=postgresql://agentic:change-me@postgres:5432/agentic_fog
FARM_ID=demo-farm
TWIN_SIMULATION_STEP_MINUTES=10
TWIN_STEP_EVERY_MESSAGES=10
FEEDBACK_STORE_PATH=/app/state/human_feedback.jsonl
FEEDBACK_EXPORT_PATH=/app/data/human_feedback_labels.jsonl


